<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Under the hardened runtime a signed build may not drive another
      application without this. Focus mode reads the front tab's address from
      the running browsers and sends a blocked one to a holding page; nothing
      else here talks to another app.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
